# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values for your environment.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# ---------------------------------------------------------------------------

# Root of the Linux RADIUS backend, including no trailing slash. Routes are
# defined in src/services/endpoints.ts and include the /v1 prefix.
VITE_API_BASE_URL=https://api-var.popserver.shop

# Seed a demo session when opened outside Telegram (local browser preview).
VITE_DEMO_MODE=true
