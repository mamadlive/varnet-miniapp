{
  "routes": [
    {
      "routePath": "/api/provider/products",
      "mountPath": "/api/provider",
      "method": "GET",
      "module": [
        "api/provider/products.ts:onRequestGet"
      ]
    },
    {
      "routePath": "/api/products",
      "mountPath": "/api",
      "method": "GET",
      "module": [
        "api/products.ts:onRequestGet"
      ]
    },
    {
      "routePath": "/api/purchase",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/purchase.ts:onRequestPost"
      ]
    },
    {
      "routePath": "/api/sync",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/sync.ts:onRequestPost"
      ]
    },
    {
      "routePath": "/api/wallet",
      "mountPath": "/api",
      "method": "GET",
      "module": [
        "api/wallet.ts:onRequestGet"
      ]
    }
  ],
  "baseURL": "/"
}